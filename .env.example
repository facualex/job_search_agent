# Copiá este archivo a .env para probar localmente (no lo subas a git).
# En GitHub Actions, estas mismas claves van como "Secrets" del repo.

# Proveedor de LLM a usar: "anthropic" o "deepseek" (default: anthropic).
LLM_PROVIDER=anthropic
# Opcional: forzar un modelo específico (si no, se usa el default de cada proveedor).
# LLM_MODEL=claude-sonnet-5

# Solo hace falta la API key del proveedor que elijas en LLM_PROVIDER.
ANTHROPIC_API_KEY=sk-ant-...
DEEPSEEK_API_KEY=sk-...

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
# Si usás Gmail: generá una "contraseña de aplicación" (no tu contraseña normal)
# en https://myaccount.google.com/apppasswords
SMTP_PASS=xxxxxxxxxxxxxxxx
EMAIL_TO=tu_correo@gmail.com
